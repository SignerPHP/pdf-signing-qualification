#!/usr/bin/env php
<?php

declare(strict_types=1);

use SignerPHP\PdfSigningQualification\Performance\FixedCostReference;
use SignerPHP\PdfSigningQualification\Performance\Protocol;
use SignerPHP\PdfSigningQualification\Signing\AttemptRunner;
use SignerPHP\PdfSigningQualification\Signing\Implementations;
use SignerPHP\PdfSigningQualification\Signing\NetworkIsolation;
use SignerPHP\PdfSigningQualification\Signing\ResourceLimits;
use SignerPHP\PdfSigningQualification\Signing\TestCredential;
use SignerPHP\PdfSigningQualification\Validation\InputPreservationValidator;
use SignerPHP\PdfSigningQualification\Validation\OpenSslCmsValidator;
use SignerPHP\PdfSigningQualification\Validation\PdfsigValidator;
use SignerPHP\PdfSigningQualification\Validation\PriorSignaturesValidator;
use SignerPHP\PdfSigningQualification\Validation\ProcessRunner;
use SignerPHP\PdfSigningQualification\Validation\PyHankoValidator;
use SignerPHP\PdfSigningQualification\Validation\QpdfCheckValidator;
use SignerPHP\PdfSigningQualification\Validation\SignatureCoverageValidator;
use SignerPHP\PdfSigningQualification\Validation\ValidationPanel;

require __DIR__.'/../vendor/autoload.php';

$arguments = array_slice($argv, 1);
if (count($arguments) !== 2 || array_filter($arguments, static fn (string $argument): bool => str_starts_with($argument, '-')) !== []) {
    fwrite(STDERR, "Usage: measure-reference <study-directory> <run-label>\n");
    exit(2);
}
[$studyDirectory, $label] = $arguments;
$studyDirectory = rtrim($studyDirectory, '/');
$referenceDirectory = "{$studyDirectory}/references/{$label}";
$scenarioPath = __DIR__.'/../config/scenarios/basic-invisible-sha256.json';
$scratchDirectory = '/sandbox/reference-'.bin2hex(random_bytes(8));
$encodeJson = static fn (array $document): string => json_encode($document, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE | JSON_THROW_ON_ERROR)."\n";
$clock = static fn (): DateTimeImmutable => new DateTimeImmutable;
$credential = null;
$exitCode = 0;

try {
    $protocol = Protocol::fromFile($studyDirectory.'/protocol.json');
    $study = json_decode((string) file_get_contents($studyDirectory.'/study.json'), true, flags: JSON_THROW_ON_ERROR);
    $planned = array_values(array_filter(is_array($study) ? $study['runs'] : [], static fn (array $run): bool => $run['label'] === $label));
    if ($planned === []) {
        throw new RuntimeException("The study in {$studyDirectory} plans no run labelled {$label}");
    }
    $implementation = Implementations::select($planned[0]['implementation_id']);
    if (file_exists($referenceDirectory)) {
        throw new RuntimeException("{$referenceDirectory} already exists");
    }
    if (! mkdir($scratchDirectory, 0700) || ! mkdir($scratchDirectory.'/credential', 0700) || ! mkdir($scratchDirectory.'/work', 0700)) {
        throw new RuntimeException("Unable to create the scratch directory {$scratchDirectory}");
    }
    $credential = TestCredential::generate($scratchDirectory.'/credential');
    $attemptRunner = new AttemptRunner(new ProcessRunner, new NetworkIsolation, $credential, $scratchDirectory.'/work', $referenceDirectory.'/outputs', new ResourceLimits, $clock);
    $panel = new ValidationPanel([
        new PyHankoValidator(new ProcessRunner, $clock),
        new PdfsigValidator(new ProcessRunner, $clock),
        new OpenSslCmsValidator(new ProcessRunner, $clock),
        new QpdfCheckValidator(new ProcessRunner, $clock),
        new InputPreservationValidator(new ProcessRunner, $clock),
        new PriorSignaturesValidator(new ProcessRunner, $clock),
        new SignatureCoverageValidator(new ProcessRunner, $clock),
    ]);
    $scenario = json_decode((string) file_get_contents($scenarioPath), true, flags: JSON_THROW_ON_ERROR);
    $records = (new FixedCostReference($attemptRunner, $panel, $scratchDirectory.'/input', $clock))
        ->measure(basename($studyDirectory)."-{$label}-reference", $scenario, $implementation, $protocol->document['reference']);

    if (! is_dir($referenceDirectory) && ! mkdir($referenceDirectory, 0777, true)) {
        throw new RuntimeException("Unable to create {$referenceDirectory}");
    }
    foreach ($records as $name => $documents) {
        $json = $encodeJson($documents);
        if (file_put_contents("{$referenceDirectory}/{$name}.json", $json) !== strlen($json)) {
            throw new RuntimeException("Unable to write {$referenceDirectory}/{$name}.json");
        }
    }
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    $exitCode = 1;
} finally {
    $credential?->remove();
    exec('rm -rf '.escapeshellarg($scratchDirectory));
}

exit($exitCode);
