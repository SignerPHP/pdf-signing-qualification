#!/usr/bin/env php
<?php

declare(strict_types=1);

use SignerPHP\PdfSigningQualification\Acquisition\SourceConfiguration;
use SignerPHP\PdfSigningQualification\Artifact;
use SignerPHP\PdfSigningQualification\Run\Environment;
use SignerPHP\PdfSigningQualification\Run\ExpectedRejections;
use SignerPHP\PdfSigningQualification\Run\Pilot;
use SignerPHP\PdfSigningQualification\Run\Summary;
use SignerPHP\PdfSigningQualification\Signing\AttemptRunner;
use SignerPHP\PdfSigningQualification\Signing\Implementations;
use SignerPHP\PdfSigningQualification\Signing\NetworkIsolation;
use SignerPHP\PdfSigningQualification\Signing\ResourceLimits;
use SignerPHP\PdfSigningQualification\Signing\TestCredential;
use SignerPHP\PdfSigningQualification\Validation\OpenSslCmsValidator;
use SignerPHP\PdfSigningQualification\Validation\PdfsigValidator;
use SignerPHP\PdfSigningQualification\Validation\ProcessRunner;
use SignerPHP\PdfSigningQualification\Validation\PyHankoValidator;
use SignerPHP\PdfSigningQualification\Validation\QpdfCheckValidator;
use SignerPHP\PdfSigningQualification\Validation\ValidationPanel;

require __DIR__.'/../vendor/autoload.php';

$arguments = array_slice($argv, 1);
$implementationId = Implementations::DEFAULT_ID;
if (str_starts_with($arguments[0] ?? '', '--implementation=')) {
    $implementationId = substr((string) array_shift($arguments), strlen('--implementation='));
}

if ($arguments === [] || array_filter($arguments, static fn (string $argument): bool => str_starts_with($argument, '-')) !== []) {
    fwrite(STDERR, "Usage: run-attempts [--implementation=<id>] <run-directory> [inputs-configuration] [input-cache] [expected-rejections]\n");
    exit(2);
}

$runDirectory = rtrim($arguments[0], '/');
$configurationPath = $arguments[1] ?? __DIR__.'/../config/inputs.json';
$cacheDirectory = $arguments[2] ?? __DIR__.'/../var/cache/inputs';
$expectedRejectionsPath = $arguments[3] ?? __DIR__.'/../config/expected-rejections.json';
$scenarioDirectory = __DIR__.'/../config/scenarios';
$scenarioPath = $scenarioDirectory.'/basic-invisible-sha256.json';
$sandboxDirectory = '/sandbox';

$readJson = static function (string $path): array {
    $document = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
    if (! is_array($document)) {
        throw new RuntimeException("{$path} does not hold a JSON object or array");
    }

    return $document;
};
$writeFile = static function (string $path, string $contents): void {
    if (file_put_contents($path, $contents) !== strlen($contents)) {
        throw new RuntimeException("Unable to write {$path}");
    }
};
$encodeJson = static fn (array $document): string => json_encode($document, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE | JSON_THROW_ON_ERROR)."\n";

$clock = static fn (): DateTimeImmutable => new DateTimeImmutable;
$scratchDirectory = $sandboxDirectory.'/run-'.bin2hex(random_bytes(8));
$credential = null;
$exitCode = 0;

try {
    $implementation = Implementations::select($implementationId);
    $inputs = SourceConfiguration::fromFile($configurationPath);
    $expectedRejections = ExpectedRejections::fromFile($expectedRejectionsPath, $inputs, $scenarioDirectory);
    $acquisitions = array_values($readJson($runDirectory.'/acquisitions.json'));

    if (! mkdir($scratchDirectory, 0700) || ! mkdir($scratchDirectory.'/credential', 0700) || ! mkdir($scratchDirectory.'/work', 0700)) {
        throw new RuntimeException("Unable to create the scratch directory {$scratchDirectory}");
    }
    $credential = TestCredential::generate($scratchDirectory.'/credential');

    $limits = new ResourceLimits;
    $attemptRunner = new AttemptRunner(new ProcessRunner, new NetworkIsolation, $credential, $scratchDirectory.'/work', $runDirectory.'/outputs', $limits, $clock);
    $panel = new ValidationPanel([
        new PyHankoValidator(new ProcessRunner, $clock),
        new PdfsigValidator(new ProcessRunner, $clock),
        new OpenSslCmsValidator(new ProcessRunner, $clock),
        new QpdfCheckValidator(new ProcessRunner, $clock),
    ]);

    $records = (new Pilot($attemptRunner, $implementation, $panel, $expectedRejections, $cacheDirectory, $clock))->run(
        basename($runDirectory),
        $readJson($scenarioPath),
        $inputs,
        $acquisitions,
        Environment::describe(getenv(Environment::IMAGE_VARIABLE), $limits),
        Artifact::describe($configurationPath),
    );

    $summary = Summary::markdown($records['run'], $records['attempts'], $records['observations']);
    $writeFile($runDirectory.'/attempts.json', $encodeJson($records['attempts']));
    $writeFile($runDirectory.'/observations.json', $encodeJson($records['observations']));
    $writeFile($runDirectory.'/summary.md', $summary);
    $writeFile($runDirectory.'/run.json', $encodeJson($records['run']));
    echo $summary;
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    $exitCode = 1;
} finally {
    $credential?->remove();
    exec('rm -rf '.escapeshellarg($scratchDirectory));
}

exit($exitCode);
