{
    "schema": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v3/scenario.schema.json",
    "id": "pades-certification-docmdp-2",
    "description": "One invisible PAdES baseline B certification signature with DocMDP permission level 2 (form filling and signing) by a certificate of the test PKI",
    "operation": "sign",
    "signing": {
        "digest_algorithm": "sha256",
        "signature_algorithm": "rsa-pkcs1-v1_5",
        "sub_filter": "ETSI.CAdES.detached",
        "appearance": "invisible",
        "timestamp": false,
        "revocation_info": false,
        "document_timestamp": false,
        "signers": [
            "valid"
        ],
        "certification_level": 2
    }
}
