{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/common.schema.json",
    "title": "Shared definitions, version 1",
    "$defs": {
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*(/[A-Za-z0-9][A-Za-z0-9._:+-]*)*$",
            "maxLength": 512
        },
        "inputIdentifier": {
            "description": "An identifier that carries the identity `<source>:<path>` of an input: the input's own, or the id of an attempt, observation or measurement built from it. Segments follow the rule of `identifier`, except that a space is kept inside a segment, as input paths may contain one; a segment still cannot end with a space.",
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9._:+ -]*[A-Za-z0-9._:+-])?(/[A-Za-z0-9]([A-Za-z0-9._:+ -]*[A-Za-z0-9._:+-])?)*$",
            "maxLength": 512
        },
        "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
        },
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "httpsUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://\\S+$"
        },
        "relativePath": {
            "description": "A path inside an upstream source, relative to its root. Each segment starts with a letter or digit and does not end with a space, so absolute paths, `.`, `..`, empty and padded segments are rejected; a space inside a segment is kept. Its length leaves room for `<source>:` within the 512 characters of an identifier.",
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9._+ -]*[A-Za-z0-9._+-])?(/[A-Za-z0-9]([A-Za-z0-9._+ -]*[A-Za-z0-9._+-])?)*$",
            "maxLength": 447
        },
        "license": {
            "description": "A license as an SPDX expression, or `NOASSERTION` when the evidence does not establish one, with the URL of that evidence.",
            "type": "object",
            "required": ["expression", "evidence_url"],
            "additionalProperties": false,
            "properties": {
                "expression": {
                    "type": "string",
                    "pattern": "^(NOASSERTION|\\(*[A-Za-z0-9.-]+\\+?\\)*( (AND|OR|WITH) \\(*[A-Za-z0-9.-]+\\+?\\)*)*)$"
                },
                "evidence_url": { "$ref": "#/$defs/httpsUrl" }
            }
        },
        "utcTimestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
        },
        "artifact": {
            "type": "object",
            "required": ["sha256", "byte_size"],
            "additionalProperties": false,
            "properties": {
                "sha256": { "$ref": "#/$defs/sha256" },
                "byte_size": { "type": "integer", "minimum": 0 }
            }
        },
        "revision": {
            "description": "Exact revision of an implementation or tool: a full commit hash or a released version, never a branch name.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["kind", "value"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "commit" },
                        "value": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
                    }
                },
                {
                    "type": "object",
                    "required": ["kind", "value"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "version" },
                        "value": { "type": "string", "pattern": "^v?[0-9]+(\\.[0-9]+)*([-+][0-9A-Za-z.+-]+)?$" }
                    }
                }
            ]
        },
        "verdict": {
            "enum": ["valid", "invalid", "inconclusive", "not_evaluated", "not_applicable"]
        },
        "metric": {
            "description": "A measured value, or the explicit statement that it could not be measured. An unavailable metric carries no value.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["status", "value"],
                    "additionalProperties": false,
                    "properties": {
                        "status": { "const": "available" },
                        "value": { "type": "number", "minimum": 0 }
                    }
                },
                {
                    "type": "object",
                    "required": ["status", "reason"],
                    "additionalProperties": false,
                    "properties": {
                        "status": { "const": "unavailable" },
                        "reason": { "$ref": "#/$defs/nonEmptyString" }
                    }
                }
            ]
        }
    }
}
