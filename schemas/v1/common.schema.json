{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/common.schema.json",
    "title": "Shared definitions, version 1",
    "$defs": {
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*(/[A-Za-z0-9][A-Za-z0-9._:+-]*)*$",
            "maxLength": 512
        },
        "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "utcTimestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
        },
        "artifact": {
            "type": "object",
            "required": ["sha256", "byte_size"],
            "additionalProperties": false,
            "properties": {
                "sha256": { "$ref": "#/$defs/sha256" },
                "byte_size": { "type": "integer", "minimum": 0 }
            }
        },
        "revision": {
            "description": "Exact revision of an implementation or tool: a full commit hash or a released version, never a branch name.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["kind", "value"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "commit" },
                        "value": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
                    }
                },
                {
                    "type": "object",
                    "required": ["kind", "value"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "version" },
                        "value": { "type": "string", "pattern": "^v?[0-9]+(\\.[0-9]+)*([-+][0-9A-Za-z.+-]+)?$" }
                    }
                }
            ]
        },
        "verdict": {
            "enum": ["valid", "invalid", "inconclusive", "not_evaluated", "not_applicable"]
        },
        "metric": {
            "description": "A measured value, or the explicit statement that it could not be measured. An unavailable metric carries no value.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["status", "value"],
                    "additionalProperties": false,
                    "properties": {
                        "status": { "const": "available" },
                        "value": { "type": "number", "minimum": 0 }
                    }
                },
                {
                    "type": "object",
                    "required": ["status", "reason"],
                    "additionalProperties": false,
                    "properties": {
                        "status": { "const": "unavailable" },
                        "reason": { "$ref": "#/$defs/nonEmptyString" }
                    }
                }
            ]
        }
    }
}
