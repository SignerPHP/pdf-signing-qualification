{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/expected-rejections.schema.json",
    "title": "Expected rejections, version 1",
    "description": "The inputs that an implementation is expected to reject under a scenario, each with its reason.",
    "type": "object",
    "required": ["schema", "rejections"],
    "additionalProperties": false,
    "properties": {
        "schema": { "const": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/expected-rejections.schema.json" },
        "rejections": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["source_id", "scenario_id", "reason"],
                "additionalProperties": false,
                "properties": {
                    "source_id": { "$ref": "common.schema.json#/$defs/inputIdentifier" },
                    "scenario_id": { "$ref": "common.schema.json#/$defs/scenarioId" },
                    "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                }
            }
        }
    }
}
