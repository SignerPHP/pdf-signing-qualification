{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/panel-pool.schema.json",
    "title": "Panel pool, version 1",
    "description": "The pool a stratified panel was drawn from, written by `bin/select-panel` next to the source configuration it produced: how many candidates each source and stratum had, how many were drawn, and how many files each exclusion left out.",
    "type": "object",
    "required": ["schema", "plan_sha256", "analyzer", "candidates", "selected", "sources", "strata"],
    "additionalProperties": false,
    "properties": {
        "schema": { "const": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/panel-pool.schema.json" },
        "plan_sha256": {
            "description": "SHA-256 of the selection plan the pool was built from.",
            "$ref": "common.schema.json#/$defs/sha256"
        },
        "analyzer": {
            "description": "The tool that recorded the strata of every candidate.",
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
                "name": { "const": "qpdf" },
                "version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            }
        },
        "candidates": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 },
        "sources": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "candidates", "selected", "excluded", "unaddressable"],
                "additionalProperties": false,
                "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/sourceId" },
                    "candidates": { "type": "integer", "minimum": 0 },
                    "selected": { "type": "integer", "minimum": 0 },
                    "unaddressable": {
                        "description": "Files that matched an include pattern and no exclusion but whose path the sources schema cannot express as an input path, such as one with parentheses, commas or equals signs; they are not candidates.",
                        "type": "integer",
                        "minimum": 0
                    },
                    "excluded": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["pattern", "reason", "files"],
                            "additionalProperties": false,
                            "properties": {
                                "pattern": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                                "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                                "files": { "type": "integer", "minimum": 0 }
                            }
                        }
                    }
                }
            }
        },
        "strata": {
            "description": "Every stratum, in the order of the sources schema, with its candidates and drawn inputs. A candidate counts once in each stratum it belongs to.",
            "type": "array",
            "items": {
                "type": "object",
                "required": ["stratum", "candidates", "selected"],
                "additionalProperties": false,
                "properties": {
                    "stratum": { "$ref": "../v2/sources.schema.json#/$defs/stratum" },
                    "candidates": { "type": "integer", "minimum": 0 },
                    "selected": { "type": "integer", "minimum": 0 }
                }
            }
        }
    }
}
