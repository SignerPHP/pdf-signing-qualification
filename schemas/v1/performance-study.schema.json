{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/performance-study.schema.json",
    "title": "Performance study session, version 1",
    "description": "One session of the paired performance study: the protocol it follows, its seed and the runs in the order they were planned, each with its role.",
    "type": "object",
    "required": ["schema", "id", "session", "seed", "protocol", "planned_at", "runs"],
    "additionalProperties": false,
    "properties": {
        "schema": { "const": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/performance-study.schema.json" },
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "session": {
            "description": "`calibration`, or the number of a measured session.",
            "oneOf": [
                { "const": "calibration" },
                { "type": "integer", "minimum": 1 }
            ]
        },
        "seed": {
            "description": "The seed of the execution order: the protocol's seed plus the session number, or the protocol's seed for the calibration.",
            "type": "integer",
            "minimum": 0
        },
        "protocol": {
            "description": "The protocol file copied into the session as `protocol.json`.",
            "$ref": "common.schema.json#/$defs/artifact"
        },
        "planned_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "runs": {
            "type": "array",
            "minItems": 2,
            "items": {
                "type": "object",
                "required": ["label", "implementation_id", "role"],
                "additionalProperties": false,
                "properties": {
                    "label": { "type": "string", "pattern": "^[0-9]{2,3}-[A-Za-z0-9][A-Za-z0-9._-]*$" },
                    "implementation_id": { "$ref": "common.schema.json#/$defs/identifier" },
                    "role": { "enum": ["calibration", "warm_up", "measured"] }
                }
            }
        }
    }
}
