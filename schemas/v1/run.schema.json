{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/run.schema.json",
    "title": "Run, version 1",
    "description": "One execution of a scenario by one implementation over every declared input, with the environment and the exact revisions of the implementation and analyzers it used.",
    "type": "object",
    "required": ["schema", "id", "scenario_id", "started_at", "finished_at", "environment", "implementation", "analyzers", "source_configuration"],
    "additionalProperties": false,
    "properties": {
        "schema": { "const": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v1/run.schema.json" },
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "scenario_id": { "$ref": "common.schema.json#/$defs/scenarioId" },
        "started_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "finished_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "environment": {
            "type": "object",
            "required": ["os", "container_image", "php_version"],
            "additionalProperties": false,
            "properties": {
                "os": {
                    "type": "object",
                    "required": ["name", "kernel", "architecture"],
                    "additionalProperties": false,
                    "properties": {
                        "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                        "kernel": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                        "architecture": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                    }
                },
                "container_image": {
                    "oneOf": [
                        {
                            "type": "object",
                            "required": ["status", "id"],
                            "additionalProperties": false,
                            "properties": {
                                "status": { "const": "available" },
                                "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                            }
                        },
                        {
                            "type": "object",
                            "required": ["status", "reason"],
                            "additionalProperties": false,
                            "properties": {
                                "status": { "const": "unavailable" },
                                "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                            }
                        }
                    ]
                },
                "cpu_model": {
                    "description": "The CPU model the run read from the host, or why it could not be read.",
                    "oneOf": [
                        {
                            "type": "object",
                            "required": ["status", "name"],
                            "additionalProperties": false,
                            "properties": {
                                "status": { "const": "available" },
                                "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                            }
                        },
                        {
                            "type": "object",
                            "required": ["status", "reason"],
                            "additionalProperties": false,
                            "properties": {
                                "status": { "const": "unavailable" },
                                "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                            }
                        }
                    ]
                },
                "php_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "resource_limits": {
                    "type": "object",
                    "required": ["timeout_seconds", "address_space_bytes", "file_size_bytes", "storage_bytes", "open_files"],
                    "additionalProperties": false,
                    "properties": {
                        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
                        "address_space_bytes": { "type": "integer", "minimum": 1 },
                        "file_size_bytes": { "type": "integer", "minimum": 1 },
                        "storage_bytes": { "type": "integer", "minimum": 1 },
                        "open_files": { "type": "integer", "minimum": 1 }
                    }
                }
            }
        },
        "implementation": { "$ref": "#/$defs/tool" },
        "implementation_runtime": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
                "java_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "java_options": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                },
                "environment_variables": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                },
                "engine": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "wrapper": { "$ref": "#/$defs/tool" }
            }
        },
        "implementation_compatibility": {
            "description": "Whether the adapter's command applies to the installed revision, checked before any attempt. An incompatible revision is still run, so every attempt records what happened.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["status"],
                    "additionalProperties": false,
                    "properties": { "status": { "enum": ["compatible", "not_checked"] } }
                },
                {
                    "type": "object",
                    "required": ["status", "reason"],
                    "additionalProperties": false,
                    "properties": {
                        "status": { "const": "incompatible" },
                        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
                    }
                }
            ]
        },
        "analyzers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/tool" }
        },
        "source_configuration": { "$ref": "common.schema.json#/$defs/artifact" },
        "expected_rejections": { "$ref": "common.schema.json#/$defs/artifact" }
    },
    "$defs": {
        "tool": {
            "type": "object",
            "required": ["id", "revision"],
            "additionalProperties": false,
            "properties": {
                "id": { "$ref": "common.schema.json#/$defs/identifier" },
                "revision": { "$ref": "common.schema.json#/$defs/revision" }
            }
        }
    }
}
