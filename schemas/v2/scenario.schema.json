{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v2/scenario.schema.json",
    "title": "Scenario, version 2",
    "description": "An explicit operation configuration. Non-equivalent configurations are distinct scenarios; nothing in a scenario may be changed silently at run time. A visible appearance declares where the signature field is placed.",
    "type": "object",
    "required": ["schema", "id", "description", "operation", "signing"],
    "additionalProperties": false,
    "properties": {
        "schema": { "const": "https://github.com/SignerPHP/pdf-signing-qualification/blob/main/schemas/v2/scenario.schema.json" },
        "id": { "$ref": "../v1/common.schema.json#/$defs/scenarioId" },
        "description": { "$ref": "../v1/common.schema.json#/$defs/nonEmptyString" },
        "operation": { "enum": ["sign"] },
        "signing": {
            "type": "object",
            "required": ["digest_algorithm", "signature_algorithm", "sub_filter", "appearance", "timestamp", "revocation_info"],
            "additionalProperties": false,
            "properties": {
                "digest_algorithm": { "enum": ["sha256", "sha384", "sha512"] },
                "signature_algorithm": { "enum": ["rsa-pkcs1-v1_5", "rsa-pss", "ecdsa"] },
                "sub_filter": { "enum": ["adbe.pkcs7.detached", "ETSI.CAdES.detached"] },
                "appearance": { "enum": ["invisible", "visible"] },
                "placement": {
                    "description": "Where the widget of a visible signature is placed: the page, counted from 1, and a rectangle in points given by its distance from the left and top edges of that page's /MediaBox and its size, in the page's default user space before any /Rotate",
                    "type": "object",
                    "required": ["page", "left", "top", "width", "height"],
                    "additionalProperties": false,
                    "properties": {
                        "page": { "type": "integer", "minimum": 1 },
                        "left": { "type": "number", "minimum": 0 },
                        "top": { "type": "number", "minimum": 0 },
                        "width": { "type": "number", "exclusiveMinimum": 0 },
                        "height": { "type": "number", "exclusiveMinimum": 0 }
                    }
                },
                "timestamp": { "type": "boolean" },
                "revocation_info": { "type": "boolean" }
            },
            "if": { "properties": { "appearance": { "const": "visible" } } },
            "then": { "required": ["placement"] },
            "else": { "not": { "required": ["placement"] } }
        }
    }
}
